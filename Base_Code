#include <WiFi.h>
#include <FirebaseESP32.h>

#include <Wire.h>
#include "MAX30105.h"
#include "spo2_algorithm.h"
#include <OneWire.h>
#include <DallasTemperature.h>
#include <Stepper.h>

// ---------------- WIFI CONFIG ----------------
#define WIFI_SSID      "Parth"
#define WIFI_PASSWORD  "parthram2004"

// ---------------- FIREBASE CONFIG ----------------
#define FIREBASE_HOST "https://magna-63a2d-default-rtdb.asia-southeast1.firebasedatabase.app/"
#define FIREBASE_AUTH "dtk9chHEcKLGJ4DqnTzKhXrgXTd7nesjfI3AiXcm"

// Firebase objects
FirebaseData firebaseData;
FirebaseConfig firebaseConfig;
FirebaseAuth firebaseAuth;
FirebaseJson json;

// ---------------- MAX30102 CONFIG ----------------
MAX30105 particleSensor;

#define BUFFER_SIZE 100
uint32_t irBuffer[BUFFER_SIZE];
uint32_t redBuffer[BUFFER_SIZE];

int32_t spo2, heartRate;
int8_t spo2Valid, heartRateValid;

int32_t lastGoodHR   = -1;
int32_t lastGoodSpO2 = -1;

const int AVG_WINDOW = 5;
int32_t hrHistory[AVG_WINDOW]   = {0};
int32_t spo2History[AVG_WINDOW] = {0};
int hrCount   = 0;
int spo2Count = 0;

// ---------------- DS18B20 CONFIG ----------------
#define ONE_WIRE_BUS 5
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature tempSensor(&oneWire);

// ---------------- STEPPER CONFIG ----------------
#define STEPS_PER_REV 2048
#define HALF_REV (STEPS_PER_REV / 2)

Stepper stepperMotor(STEPS_PER_REV, 2, 4, 18, 19);
bool valveClosed = false;

// ---------------- ALERT THRESHOLDS ----------------
const float TEMP_THRESHOLD_F = 94.0;
const int   HR_HIGH_LIMIT    = 120;
const int   HR_LOW_LIMIT     = 50;

// Firebase timing
unsigned long lastPush = 0;
const unsigned long interval = 2000;  // 2s

void setup() {
  Serial.begin(115200);
  delay(500);

  Serial.println("ESP32 + MAX30102 + DS18B20 + Stepper + Firebase (Random saline/bubble)");

  // ---------- WIFI ----------
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    Serial.print(".");
    delay(500);
  }
  Serial.println("\nWiFi Connected.");
  Serial.print("IP: ");
  Serial.println(WiFi.localIP());

  // ---------- Firebase (NEW API with config/auth) ----------
  firebaseConfig.host = FIREBASE_HOST;
  firebaseConfig.signer.tokens.legacy_token = FIREBASE_AUTH;
  Firebase.begin(&firebaseConfig, &firebaseAuth);
  Firebase.reconnectWiFi(true);
  Serial.println("Firebase initialized.");

  // ---------- MAX30102 ----------
  Wire.begin(21, 22);  // SDA, SCL

  if (!particleSensor.begin(Wire, I2C_SPEED_FAST)) {
    Serial.println("MAX30102 NOT FOUND!");
    while (1) delay(1000);
  }
  Serial.println("MAX30102 found.");

  // ledBrightness, sampleAverage, ledMode, sampleRate, pulseWidth, adcRange
  particleSensor.setup(0x7F, 8, 2, 100, 411, 16384);

  // Fill initial buffer
  for (int i = 0; i < BUFFER_SIZE; i++) {
    while (!particleSensor.available()) particleSensor.check();
    redBuffer[i] = particleSensor.getRed();
    irBuffer[i]  = particleSensor.getIR();
    particleSensor.nextSample();
  }

  // ---------- DS18B20 ----------
  tempSensor.begin();

  // ---------- Stepper ----------
  stepperMotor.setSpeed(10);  // RPM
}

void loop() {

  // -------- MAX30102 READ & HR/SpO2 --------
  const int shiftAmount = 75;
  const int newSamples  = BUFFER_SIZE - shiftAmount;

  for (int i = 0; i < shiftAmount; i++) {
    redBuffer[i] = redBuffer[i + newSamples];
    irBuffer[i]  = irBuffer[i + newSamples];
  }

  for (int i = shiftAmount; i < BUFFER_SIZE; i++) {
    while (!particleSensor.available()) particleSensor.check();
    redBuffer[i] = particleSensor.getRed();
    irBuffer[i]  = particleSensor.getIR();
    particleSensor.nextSample();
  }

  maxim_heart_rate_and_oxygen_saturation(
    irBuffer, BUFFER_SIZE, redBuffer,
    &spo2, &spo2Valid, &heartRate, &heartRateValid
  );

  bool hr_ok   = (heartRateValid == 1 && heartRate > 40 && heartRate < 180);
  bool spo2_ok = (spo2Valid == 1     && spo2 >= 80 && spo2 <= 100);

  if (hr_ok) {
    hrHistory[hrCount % AVG_WINDOW] = heartRate;
    hrCount++;
    lastGoodHR = heartRate;
  }
  if (spo2_ok) {
    spo2History[spo2Count % AVG_WINDOW] = spo2;
    spo2Count++;
    lastGoodSpO2 = spo2;
  }

  int32_t avgHR = -1;
  int32_t avgSpO2 = -1;

  if (hrCount > 0) {
    int n = min(hrCount, AVG_WINDOW);
    long sum = 0;
    for (int i = 0; i < n; i++) sum += hrHistory[i];
    avgHR = sum / n;
  }

  if (spo2Count > 0) {
    int n = min(spo2Count, AVG_WINDOW);
    long sum = 0;
    for (int i = 0; i < n; i++) sum += spo2History[i];
    avgSpO2 = sum / n;
  }

  // -------- Temperature --------
  tempSensor.requestTemperatures();
  float tempC = tempSensor.getTempCByIndex(0);
  float tempF = tempC * 9.0 / 5.0 + 32.0;

  // -------- RANDOM saline & bubble (no extra hardware) --------
  float salinePercent = random(0, 101);      // 0–100 %
  bool  bubbleDetected = (random(0, 2) == 1); // true/false

  // -------- Alerts --------
  bool hrAlert   = (avgHR >= HR_HIGH_LIMIT || avgHR <= HR_LOW_LIMIT);
  bool tempAlert = (tempF < TEMP_THRESHOLD_F);
  bool alert = hrAlert || tempAlert;

  // -------- Stepper --------
  if (alert && !valveClosed) {
    Serial.println(">> ALERT ON: Closing (half revolution)...");
    stepperMotor.step(HALF_REV);
    valveClosed = true;
  }

  if (!alert && valveClosed) {
    Serial.println(">> ALERT OFF: Opening (half revolution back)...");
    stepperMotor.step(-HALF_REV);
    valveClosed = false;
  }

  // -------- Serial debug --------
  Serial.print("HR: ");
  Serial.print(avgHR > 0 ? avgHR : lastGoodHR);
  Serial.print(" | SpO2: ");
  Serial.print(avgSpO2 > 0 ? avgSpO2 : lastGoodSpO2);
  Serial.print(" | TempF: ");
  Serial.print(tempF);
  Serial.print(" | Saline: ");
  Serial.print(salinePercent);
  Serial.print("% | Bubble: ");
  Serial.print(bubbleDetected ? "YES" : "NO");
  Serial.print(" | ALERT: ");
  Serial.println(alert ? "YES" : "NO");

  // -------- Firebase Upload (using FirebaseESP32.h API) --------
  if (millis() - lastPush > interval) {
    lastPush = millis();

    json.clear();
    json.set("heartRate",   avgHR);
    json.set("spo2",        avgSpO2);
    json.set("temperatureF", tempF);
    json.set("salinePercent", salinePercent);
    json.set("bubbleDetected", bubbleDetected);
    json.set("hrAlert", hrAlert);
    json.set("tempAlert", tempAlert);
    json.set("alert", alert);

    if (Firebase.setJSON(firebaseData, "/patient1", json)) {
      Serial.println("Firebase: /patient1 updated");
    } else {
      Serial.print("Firebase error: ");
      Serial.println(firebaseData.errorReason());
    }
  }

  delay(200);
}
